# AuditAI — Backend Django (API + Admin)
# Build:  docker build -f Dockerfile.backend -t audit-backend .
# Run:    gerido pelo docker-compose.yml
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# deps mínimas de runtime (psycopg2-binary não precisa de gcc; openpyxl/pandas rodam em slim)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1) dependências primeiro (cache de camadas)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

# 2) código
COPY . .

RUN chmod +x docker/entrypoint.backend.sh && python manage.py collectstatic --noinput || true

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/django/api/health || exit 1

ENTRYPOINT ["./docker/entrypoint.backend.sh"]
