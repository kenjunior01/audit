# Audit Platform — variáveis de ambiente (copie para .env e ajuste)

# --- Django ---
AUDIT_DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
AUDIT_DEBUG=False                  # True apenas em desenvolvimento
AUDIT_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de dados ---
# Default: SQLite (audit_v2.db). Para PostgreSQL em produção:
# AUDIT_DATABASE_URL=postgres://usuario:senha@localhost:5432/audit
AUDIT_DB_NAME=audit_v2.db

# --- CORS ---
AUDIT_CORS_ALLOW_ALL=False         # True só em desenvolvimento
AUDIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Segurança ---
AUDIT_SSL_REDIRECT=False           # True atrás de HTTPS/proxy
AUDIT_HSTS_SECONDS=31536000

# --- Rate limiting (API) ---
AUDIT_THROTTLE_ANON=60/min
AUDIT_THROTTLE_USER=600/min

# --- Serviços self-hosted (docker-compose.yml) ---
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Copiloto Excel IA (LLM self-hosted) ---
# Modelo Ollama para o assistente NL→Excel (default: deepseek-r1:1.5b)
# AUDIT_OLLAMA_MODEL=qwen2.5:7b
# Timeout em segundos para o plano do LLM (fallback determinístico após isto)
AUDIT_OLLAMA_TIMEOUT=25
# Cooldown (s) da sonda de disponibilidade do Ollama: com o LLM em baixo,
# o chat degrada para o modo regras sem esperar o timeout em cada pedido.
# 0 desativa o cooldown (sonda sempre).
AUDIT_OLLAMA_PROBE_TTL=60

# --- Copiloto Global da Plataforma (Omni Copilot) ---
# Usa o mesmo LLM self-hosted do Copiloto Excel (OLLAMA_URL + AUDIT_OLLAMA_MODEL).
# Sem Ollama ativo, o Copiloto responde em modo determinístico (regras) —
# sempre com dados vivos da plataforma, nunca degrada para erro.
# AUDIT_OLLAMA_MODEL=qwen2.5:7b
# AUDIT_OLLAMA_TIMEOUT=25
#
# Streaming SSE: POST /ai/copilot/stream mostra a execução agéntica em tempo
# real (ferramentas consultadas). Feedback do utilizador: POST /ai/copilot/feedback.
#
# Cache TTL (segundos) das ferramentas pesadas do Copiloto (Benford,
# duplicados, previsão, perfil de fornecedor). 0 desativa.
# AUDIT_COPILOT_CACHE_TTL=45

# --- Digest programado do Copiloto Global (cron push) ----------------------
# Resumo automático (briefing + sinais proativos + qualidade do copiloto).
# Alternativas de agendamento:
#   1) Celery beat:  AUDIT_DIGEST_ENABLED=true  (+ worker e beat a correr)
#   2) Cron clássico: 0 7 * * * python manage.py copilot_digest
# Destinatários do email (separados por vírgula; vazio = só persiste):
# AUDIT_DIGEST_EMAILS=gestor@empresa.com,cfo@empresa.com
# Hora do dia do digest (0-23, default 7 UTC):
# AUDIT_DIGEST_HOUR=7
# Email remetente:
# AUDIT_DEFAULT_FROM_EMAIL=copiloto@audit-platform

# --- Email / SMTP (necessário para o digest enviar de verdade) -----------
# Console por defeito (só regista no log). Para produção:
AUDIT_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# AUDIT_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp empresa.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=digest@empresa.com
# EMAIL_HOST_PASSWORD=***
# EMAIL_USE_TLS=True

# --- Docker compose (docker-compose.yml) ---------------------------------
# POSTGRES_DB=audit
# POSTGRES_USER=audit
# POSTGRES_PASSWORD=troque-esta-senha
# NEXT_PUBLIC_API_BASE=http://backend:8000
# GUNICORN_WORKERS=3
